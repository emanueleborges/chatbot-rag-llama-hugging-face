# Copie para .env e preencha (não commite .env com chaves reais).
# Docker Compose lê este ficheiro como .env na raiz para interpolar variáveis em docker-compose.yml.
#
# --- Ollama na NUVEM (ollama.com) ---
# OLLAMA_API_KEY=<chave em https://ollama.com/settings/keys>
# OLLAMA_BASE_URL=https://ollama.com/v1
# OLLAMA_MODEL=gpt-oss:20b
#
# --- Ollama LOCAL (PC) ---
# OLLAMA_API_KEY pode ficar vazio; o código usa a chave placeholder "ollama".
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2:1b
#
# --- Ollama no DOCKER (compose com docker-compose.ollama.yml) ---
# OLLAMA_BASE_URL=http://ollama:11434/v1
# OLLAMA_API_KEY=ollama
# OLLAMA_MODEL=llama3.2:1b
#
# --- Servidor uvicorn (opcional) ---
# UVICORN_HOST=0.0.0.0
# UVICORN_PORT=8000
# UVICORN_RELOAD=1

OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gpt-oss:20b

HF_API_TOKEN=
HF_IMAGE_MODEL=runwayml/stable-diffusion-v1-5
IMAGE_BACKEND=auto

# ChromaDB (RAG vectorial). Pasta onde o SQLite + vetores são guardados.
# CHROMA_PATH=c:/caminho/chroma_db
# Modelo Sentence-Transformers (multilingue; primeira execução faz download).
# CHROMA_EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
