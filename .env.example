# .env
SECRET_KEY=sua-chave-secreta-aqui-mude-em-producao
# Preferir 127.0.0.1: em macOS `localhost` pode ir para ::1 e não ser o mesmo Ollama onde corre `ollama pull`.
OLLAMA_URL=http://127.0.0.1:11434
# Tem de coincidir com um nome em `ollama list` (senão 404 no chat). Ex.: llama3.2:1b, ibm/granite4:micro
OLLAMA_MODEL=llama3.2:3b
SD_API_URL=http://127.0.0.1:7860
REDIS_HOST=localhost
REDIS_PORT=6379

# Google Gemini (embeddings + LLM quando GEMINI_API_KEY ou GOOGLE_API_KEY estiver definida)
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_TEMPERATURE=0.2
# GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Memória conversacional (janela de interações user/assistant)
# CONV_BUFFER_WINDOW=5

# Recuperação + re-ranking
# RAG_FETCH_K=20
# RAG_FINAL_K=5
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# DISABLE_RERANKER=false

# Limpa cache Redis do pipeline legado (database.py) ao chamar DELETE /cache
# ENABLE_LEGACY_REDIS_CACHE_CLEAR=false