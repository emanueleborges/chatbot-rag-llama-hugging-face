# Local (fora do Docker)
OLLAMA_URL=http://127.0.0.1:11434
# Docker Compose (Ollama nativo no Mac — porta 11434 já em uso)
# OLLAMA_URL=http://host.docker.internal:11434
# Docker Compose com Ollama no container (--profile docker-ollama)
# OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=ibm/granite4:micro
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CONV_BUFFER_WINDOW=6
RAG_TOP_K=5
JURIDICO_API_PORT=8011
GRADIO_PORT=7861

# DataJud (metadados de processos — NÃO inclui petição inicial)
# https://www.cnj.jus.br/sistemas/datajud/api-publica/
# DATAJUD_API_KEY=
